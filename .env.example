# Supabase project settings (the URL and anon key are public browser config).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only secrets. Never prefix these with NEXT_PUBLIC_ or expose them to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Arkesel SMS API (server-side Vercel environment variables only).
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_SENDER_ID=BISA
